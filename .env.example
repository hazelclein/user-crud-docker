# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=userdb
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=5m

# Jaeger
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
ENVIRONMENT=development